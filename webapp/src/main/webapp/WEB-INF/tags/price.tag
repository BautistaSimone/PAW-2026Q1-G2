<%@ tag language="java" pageEncoding="UTF-8" %><%@ attribute name="value" required="true" type="java.lang.Number" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><fmt:setLocale value="es-AR" /><fmt:formatNumber value="${value}" type="number" groupingUsed="true" minFractionDigits="0" maxFractionDigits="2" var="formattedPrice" /><spring:message code="Global.currency.symbol"/><c:out value="${formattedPrice}" />
